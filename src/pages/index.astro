---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";

import Research from "../sections/Research.astro";
import Communication from "../sections/ScienceCommunication.astro";
import Teaching from "../sections/Teaching.astro";
import Hobbies from "../sections/Hobbies.astro";

import { profile } from "../config";

const year = new Date().getFullYear();
---

<BaseLayout
  title={profile.name}
  description={`Personal academic website of ${profile.name}.`}
>
  <div class="page">
    <Header />

    <main>
      <Research />
      <Communication />
      <Teaching />
      <Hobbies />
    </main>

    <footer>
      © {year} {profile.name}
    </footer>
  </div>
</BaseLayout>